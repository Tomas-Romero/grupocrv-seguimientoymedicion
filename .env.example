# Copiar a .env: cp .env.example .env
DATABASE_URL=postgres://metrics:metrics@localhost:5432/metrics?sslmode=disable
# Si el puerto 5432 esta ocupado (por ejemplo por un PostgreSQL instalado en Windows),
# cambia DB_PORT y el puerto de DATABASE_URL al mismo valor. Ejemplo: 5433.
DB_PORT=5432
HTTP_ADDR=:8080
LOG_LEVEL=debug
