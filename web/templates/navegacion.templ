package plantillas

// Navegacion es el menu global: los destinos que existen fuera de un proyecto.
templ Navegacion(p Pagina) {
	<nav aria-label="Principal">
		<ul class="flex flex-wrap items-center gap-x-1 gap-y-1">
			for _, e := range p.EnlacesGlobales() {
				<li>
					@enlaceNav(e)
				</li>
			}
		</ul>
	</nav>
}

// NavegacionProyecto es el menu de un proyecto. No dibuja nada si la pagina no
// esta dentro de un proyecto.
templ NavegacionProyecto(p Pagina) {
	if p.Proyecto != nil {
		<div class="border-t border-slate-200 bg-slate-50">
			<div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-2">
				<span class="max-w-full truncate rounded-md bg-white px-2.5 py-1 text-sm text-slate-600 ring-1 ring-slate-200">
					Proyecto: <strong class="font-semibold text-slate-900">{ p.Proyecto.Nombre }</strong>
				</span>
				<nav aria-label="Proyecto">
					<ul class="flex flex-wrap items-center gap-x-1 gap-y-1">
						for _, e := range p.EnlacesProyecto() {
							<li>
								@enlaceNav(e)
							</li>
						}
					</ul>
				</nav>
			</div>
		</div>
	}
}

templ enlaceNav(e Enlace) {
	<a
		href={ templ.URL(e.Href) }
		class={ e.Clases() }
		if e.Activo {
			aria-current="page"
		}
	>
		{ e.Texto }
	</a>
}
