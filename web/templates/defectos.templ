package plantillas

// ListaDeDefectos es la pantalla /proyectos/{id}/defectos: los filtros, la tabla de defectos del mas
// reciente al mas antiguo y el formulario para registrar uno.
templ ListaDeDefectos(v VistaDefectos) {
	<h1 class={ claseTitulo }>Defectos</h1>
	<form method="get" action={ templ.URL(v.Filtros.Accion) } class="mt-4 flex flex-wrap items-end gap-4">
		<div>
			<label for="filtro-sprint" class={ claseEtiqueta }>Sprint de detección</label>
			<select id="filtro-sprint" name="sprint" class={ claseCampo }>
				for _, o := range v.Filtros.Sprints {
					<option value={ o.Valor } selected?={ o.Elegida }>{ o.Texto }</option>
				}
			</select>
		</div>
		<div>
			<label for="filtro-severidad" class={ claseEtiqueta }>Severidad</label>
			<select id="filtro-severidad" name="severidad" class={ claseCampo }>
				for _, o := range v.Filtros.Severidades {
					<option value={ o.Valor } selected?={ o.Elegida }>{ o.Texto }</option>
				}
			</select>
		</div>
		<button type="submit" class={ claseBoton }>Filtrar</button>
	</form>
	if len(v.Defectos) == 0 {
		if v.Filtros.Activo {
			<p class="mt-4 text-slate-700">Ningún defecto cumple los filtros</p>
		} else {
			<p class="mt-4 text-slate-700">Todavía no hay defectos</p>
		}
	} else {
		<table class="mt-4 w-full border-collapse text-left text-sm">
			<caption class="sr-only">Defectos del proyecto, del más reciente al más antiguo</caption>
			<thead>
				<tr class="border-b border-slate-300">
					<th scope="col" class="py-2 pr-3 font-semibold">Descripción</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Severidad</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Estado</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Historia</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Sprint de detección</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Sprint de resolución</th>
					<th scope="col" class="py-2 font-semibold">Acciones</th>
				</tr>
			</thead>
			<tbody>
				for _, d := range v.Defectos {
					<tr class="border-b border-slate-200 align-top">
						<td class="py-2 pr-3 whitespace-pre-wrap">{ d.Descripcion }</td>
						<td class="py-2 pr-3">{ d.Severidad }</td>
						<td class="py-2 pr-3">{ d.Estado }</td>
						<td class="py-2 pr-3">{ d.Historia }</td>
						<td class="py-2 pr-3">{ d.SprintDeteccion }</td>
						<td class="py-2 pr-3">{ d.SprintResolucion }</td>
						<td class="py-2">
							<div class="flex flex-col gap-2">
								for _, a := range d.Acciones {
									<form hx-post={ d.Accion } class="flex items-center gap-2">
										<input type="hidden" name="estado" value={ a.Estado }/>
										if a.ConSprint {
											<select name="sprint_resolucion" aria-label={ "Sprint de resolución: " + d.Nombre } class="rounded border border-slate-300 bg-white px-2 py-1 text-xs">
												for _, o := range d.Sprints {
													<option value={ o.Valor }>{ o.Texto }</option>
												}
											</select>
										}
										<button type="submit" aria-label={ a.Texto + ": " + d.Nombre } class={ claseBotonChico }>{ a.Texto }</button>
									</form>
								}
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	<h2 class="mt-10 text-lg font-semibold text-slate-900">Registrar defecto</h2>
	<form hx-post={ v.Alta.Accion } class="mt-4 max-w-xl space-y-4">
		<div>
			<label for="descripcion" class={ claseEtiqueta }>Descripción</label>
			<textarea id="descripcion" name="descripcion" rows="5" class={ claseCampo }></textarea>
		</div>
		<div>
			<label for="severidad" class={ claseEtiqueta }>Severidad</label>
			<select id="severidad" name="severidad" class={ claseCampo }>
				for _, o := range v.Alta.Severidades {
					<option value={ o.Valor }>{ o.Texto }</option>
				}
			</select>
		</div>
		<div>
			<label for="historia" class={ claseEtiqueta }>Historia relacionada</label>
			<select id="historia" name="historia" class={ claseCampo }>
				for _, o := range v.Alta.Historias {
					<option value={ o.Valor }>{ o.Texto }</option>
				}
			</select>
			if v.Alta.SinHistorias {
				<p class="mt-1 text-sm text-slate-700">Primero cargá una historia</p>
			}
		</div>
		<div>
			<label for="sprint_deteccion" class={ claseEtiqueta }>Sprint de detección</label>
			<select id="sprint_deteccion" name="sprint_deteccion" class={ claseCampo }>
				for _, o := range v.Alta.Sprints {
					<option value={ o.Valor }>{ o.Texto }</option>
				}
			</select>
			if v.Alta.SinSprints {
				<p class="mt-1 text-sm text-slate-700">Primero creá un sprint</p>
			}
		</div>
		<div>
			<button type="submit" class={ claseBoton }>Registrar defecto</button>
		</div>
	</form>
}
