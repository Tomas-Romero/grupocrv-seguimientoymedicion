package plantillas

// ListaDeProyectos es la pantalla /proyectos.
templ ListaDeProyectos(v VistaProyectos) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class={ claseTitulo }>Proyectos</h1>
		<a href="/proyectos/nuevo" class={ claseBoton }>Nuevo proyecto</a>
	</div>
	if len(v.Proyectos) == 0 {
		<p class="mt-6 text-slate-700">Todavía no hay proyectos. Creá el primero con "Nuevo proyecto".</p>
	} else {
		<table class="mt-6 w-full border-collapse text-left text-sm">
			<caption class="sr-only">Lista de proyectos</caption>
			<thead>
				<tr class="border-b border-slate-300">
					<th scope="col" class="py-2 pr-4 font-semibold">Nombre</th>
					<th scope="col" class="py-2 pr-4 font-semibold">Inicio</th>
					<th scope="col" class="py-2 font-semibold">Fin</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range v.Proyectos {
					<tr class="border-b border-slate-200">
						<td class="py-2 pr-4"><a href={ templ.URL("/proyectos/" + p.ID) } class={ claseEnlace }>{ p.Nombre }</a></td>
						<td class="py-2 pr-4">{ p.Inicio }</td>
						<td class="py-2">{ p.Fin }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// FormularioDeProyecto es la pantalla de alta (/proyectos/nuevo) y de edicion de un proyecto.
templ FormularioDeProyecto(f FormProyecto) {
	<h1 class={ claseTitulo }>{ f.Encabezado }</h1>
	<form hx-post={ f.Accion } class="mt-6 max-w-xl space-y-4">
		<div>
			<label for="nombre" class={ claseEtiqueta }>Nombre</label>
			<input type="text" id="nombre" name="nombre" value={ f.Nombre } class={ claseCampo }/>
		</div>
		<div>
			<label for="descripcion" class={ claseEtiqueta }>Descripción</label>
			<textarea id="descripcion" name="descripcion" rows="3" class={ claseCampo }>{ f.Descripcion }</textarea>
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			<div>
				<label for="fecha_inicio" class={ claseEtiqueta }>Fecha de inicio</label>
				<input type="date" id="fecha_inicio" name="fecha_inicio" value={ f.FechaInicio } class={ claseCampo }/>
			</div>
			<div>
				<label for="fecha_fin" class={ claseEtiqueta }>Fecha de fin</label>
				<input type="date" id="fecha_fin" name="fecha_fin" value={ f.FechaFin } class={ claseCampo }/>
			</div>
		</div>
		<div class="flex items-center gap-4">
			<button type="submit" class={ claseBoton }>Guardar</button>
			<a href={ templ.URL(f.Volver) } class={ claseEnlace }>Cancelar</a>
		</div>
	</form>
}

// ResumenDeProyecto es la pantalla /proyectos/{id}: los datos, los integrantes y el
// formulario para registrar uno.
templ ResumenDeProyecto(v VistaProyecto) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class={ claseTitulo }>{ v.Nombre }</h1>
		<a href={ templ.URL(v.Editar) } class={ claseEnlace }>Editar proyecto</a>
	</div>
	<dl class="mt-4 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
		<dt class="font-semibold text-slate-700">Descripción</dt>
		<dd>{ v.Descripcion }</dd>
		<dt class="font-semibold text-slate-700">Inicio</dt>
		<dd>{ v.Inicio }</dd>
		<dt class="font-semibold text-slate-700">Fin</dt>
		<dd>{ v.Fin }</dd>
	</dl>
	<p class="mt-4 flex gap-6 text-sm">
		<a href={ templ.URL(v.Backlog) } class={ claseEnlace }>Ver el backlog</a>
		<a href={ templ.URL(v.Sprints) } class={ claseEnlace }>Ver los sprints</a>
	</p>
	<h2 class="mt-8 text-lg font-semibold text-slate-900">Integrantes</h2>
	if len(v.Integrantes) == 0 {
		<p class="mt-2 text-slate-700">No hay integrantes registrados.</p>
	} else {
		<ul class="mt-2 divide-y divide-slate-200 text-sm">
			for _, i := range v.Integrantes {
				<li class="py-2">
					<span class="font-medium">{ i.Nombre }</span>
					<span class="text-slate-600"> · { i.Email } · { i.Rol }</span>
				</li>
			}
		</ul>
	}
	<h3 class="mt-6 text-base font-semibold text-slate-900">Registrar un integrante</h3>
	<form hx-post={ v.AltaIntegrante } class="mt-2 grid max-w-3xl gap-4 sm:grid-cols-3">
		<div>
			<label for="nombre" class={ claseEtiqueta }>Nombre</label>
			<input type="text" id="nombre" name="nombre" class={ claseCampo }/>
		</div>
		<div>
			<label for="email" class={ claseEtiqueta }>Email</label>
			<input type="text" id="email" name="email" class={ claseCampo }/>
		</div>
		<div>
			<label for="rol" class={ claseEtiqueta }>Rol</label>
			<select id="rol" name="rol" class={ claseCampo }>
				for _, o := range v.Roles {
					<option value={ o.Valor } selected?={ o.Elegida }>{ o.Texto }</option>
				}
			</select>
		</div>
		<div class="sm:col-span-3">
			<button type="submit" class={ claseBoton }>Registrar integrante</button>
		</div>
	</form>
}
