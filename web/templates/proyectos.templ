package plantillas

// ListaDeProyectos es la pantalla /proyectos.
templ ListaDeProyectos(v VistaProyectos) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class={ claseTitulo }>Proyectos</h1>
		<a href="/proyectos/nuevo" class={ claseBoton }>Nuevo proyecto</a>
	</div>
	if len(v.Proyectos) == 0 {
		<p class={ "mt-6 " + claseDato }>Todavía no hay proyectos. Creá el primero con "Nuevo proyecto".</p>
	} else {
		<div class={ claseTablaContenedor }>
			<table class={ claseTabla }>
				<caption class="sr-only">Lista de proyectos</caption>
				<thead>
					<tr>
						<th scope="col" class={ claseEncabezado }>Nombre</th>
						<th scope="col" class={ claseEncabezado }>Inicio</th>
						<th scope="col" class={ claseEncabezado }>Fin</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range v.Proyectos {
						<tr class={ claseFila }>
							<td class={ claseCelda }><a href={ templ.URL("/proyectos/" + p.ID) } class={ claseEnlace }>{ p.Nombre }</a></td>
							<td class={ claseCelda + " tabular-nums" }>{ p.Inicio }</td>
							<td class={ claseCelda + " tabular-nums" }>{ p.Fin }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// FormularioDeProyecto es la pantalla de alta (/proyectos/nuevo) y de edicion de un proyecto.
templ FormularioDeProyecto(f FormProyecto) {
	<h1 class={ claseTitulo }>{ f.Encabezado }</h1>
	<form hx-post={ f.Accion } class={ "mt-6 max-w-xl space-y-4 " + claseTarjeta }>
		<div>
			<label for="nombre" class={ claseEtiqueta }>Nombre</label>
			<input type="text" id="nombre" name="nombre" value={ f.Nombre } class={ claseCampo }/>
		</div>
		<div>
			<label for="descripcion" class={ claseEtiqueta }>Descripción</label>
			<textarea id="descripcion" name="descripcion" rows="3" class={ claseCampo }>{ f.Descripcion }</textarea>
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			<div>
				<label for="fecha_inicio" class={ claseEtiqueta }>Fecha de inicio</label>
				<input type="date" id="fecha_inicio" name="fecha_inicio" value={ f.FechaInicio } class={ claseCampo }/>
			</div>
			<div>
				<label for="fecha_fin" class={ claseEtiqueta }>Fecha de fin</label>
				<input type="date" id="fecha_fin" name="fecha_fin" value={ f.FechaFin } class={ claseCampo }/>
			</div>
		</div>
		<div class="flex items-center gap-4">
			<button type="submit" class={ claseBoton }>Guardar</button>
			<a href={ templ.URL(f.Volver) } class={ claseEnlace }>Cancelar</a>
		</div>
	</form>
}

// ResumenDeProyecto es la pantalla /proyectos/{id}: los datos, los integrantes y el
// formulario para registrar uno.
// tarjetaDeEstado es el estado general del proyecto (spec US-004): el estado segun sus fechas, las historias por estado, los
// Story Points, el porcentaje y el sprint abierto. Si falla el calculo, informa el error y el resto de la pagina se muestra. Cada cifra
// es un texto entero («Story Points: 5 completados de 10») dentro de su propio recuadro: el texto no se parte.
templ tarjetaDeEstado(e VistaEstadoProyecto) {
	<section aria-labelledby="estado-general" class={ "mt-4 border-l-4 border-l-indigo-600 " + claseTarjeta }>
		<h2 id="estado-general" class="text-sm font-semibold uppercase tracking-wide text-slate-600">Estado general</h2>
		<p class="mt-1 text-2xl font-semibold text-slate-900">{ e.Estado }</p>
		if e.Error != "" {
			<p role="alert" class="mt-2 text-red-700">{ e.Error }</p>
		} else {
			<ul class="mt-3 grid gap-2 sm:grid-cols-2">
				<li class={ claseDato }>{ e.Historias }</li>
				<li class={ claseDato }>{ e.StoryPoints }</li>
				<li class={ claseDato }>{ e.Porcentaje }</li>
				<li class={ claseDato }>
					if e.SprintEnlace != "" {
						<a href={ templ.URL(e.SprintEnlace) } class={ claseEnlace }>{ e.Sprint }</a>
					} else {
						{ e.Sprint }
					}
				</li>
			</ul>
		}
	</section>
}

templ ResumenDeProyecto(v VistaProyecto) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class={ claseTitulo }>{ v.Nombre }</h1>
		<a href={ templ.URL(v.Editar) } class={ claseBotonSecundario }>Editar proyecto</a>
	</div>
	@tarjetaDeEstado(v.Estado)
	<section class={ "mt-6 " + claseTarjeta }>
		<dl class="grid gap-x-8 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
			<dt class="font-semibold text-slate-700">Descripción</dt>
			<dd>{ v.Descripcion }</dd>
			<dt class="font-semibold text-slate-700">Inicio</dt>
			<dd>{ v.Inicio }</dd>
			<dt class="font-semibold text-slate-700">Fin</dt>
			<dd>{ v.Fin }</dd>
		</dl>
		<p class="mt-4 flex flex-wrap gap-3 text-sm">
			<a href={ templ.URL(v.Backlog) } class={ claseBotonSecundarioChico }>Ver el backlog</a>
			<a href={ templ.URL(v.Sprints) } class={ claseBotonSecundarioChico }>Ver los sprints</a>
		</p>
	</section>
	<h2 class={ "mt-8 " + claseSubtitulo }>Integrantes</h2>
	if len(v.Integrantes) == 0 {
		<p class={ "mt-2 " + claseDato }>No hay integrantes registrados.</p>
	} else {
		<ul class={ "mt-2 divide-y divide-slate-200 text-sm " + claseTarjeta + " py-2" }>
			for _, i := range v.Integrantes {
				<li class="flex items-center gap-3 py-2">
					<span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-900">{ iniciales(i.Nombre) }</span>
					<span class="min-w-0">
						<span class="font-medium">{ i.Nombre }</span>
						<span class="text-slate-600"> · { i.Email } · { i.Rol }</span>
					</span>
				</li>
			}
		</ul>
	}
	<h3 class={ "mt-6 " + claseSubtitulo }>Registrar un integrante</h3>
	<form hx-post={ v.AltaIntegrante } class={ "mt-2 grid max-w-3xl gap-4 sm:grid-cols-3 " + claseTarjeta }>
		<div>
			<label for="nombre" class={ claseEtiqueta }>Nombre</label>
			<input type="text" id="nombre" name="nombre" class={ claseCampo }/>
		</div>
		<div>
			<label for="email" class={ claseEtiqueta }>Email</label>
			<input type="text" id="email" name="email" class={ claseCampo }/>
		</div>
		<div>
			<label for="rol" class={ claseEtiqueta }>Rol</label>
			<select id="rol" name="rol" class={ claseCampo }>
				for _, o := range v.Roles {
					<option value={ o.Valor } selected?={ o.Elegida }>{ o.Texto }</option>
				}
			</select>
		</div>
		<div class="sm:col-span-3">
			<button type="submit" class={ claseBoton }>Registrar integrante</button>
		</div>
	</form>
}
