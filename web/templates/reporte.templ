package plantillas

// ReporteDeProyecto es la pagina /proyectos/{id}/reporte y ReporteDeSprint, /proyectos/{id}/sprints/{sprint}/reporte (spec US-033): todas
// las secciones del reporte en una sola pagina, siempre en el mismo orden, cada una dentro de un <section> con su titulo y su id. Funciona
// sin JavaScript. US-034 le suma el boton para imprimir o guardar como PDF (oculto hasta que lo muestra imprimir.js), un encabezado que
// solo se ve al imprimir y la clase reporte, que usan las reglas de impresion de input.css.
templ ReporteDeProyecto(v VistaReporte) {
	@reporte(v)
}

templ ReporteDeSprint(v VistaReporte) {
	@reporte(v)
}

templ reporte(v VistaReporte) {
	<div class="reporte">
		<div class="solo-impresion mb-4 border-b border-slate-400 pb-2 text-sm">
			<p class="font-semibold">{ v.Proyecto }</p>
			<p>{ v.Titulo }</p>
			<p>{ v.Generado }</p>
		</div>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h1 class={ claseTitulo }>{ v.Titulo }</h1>
			<div class="flex flex-wrap items-center gap-4">
				<button type="button" id="imprimir" class={ "no-imprimir " + claseBoton } hidden>Imprimir o guardar como PDF</button>
				<a href={ templ.URL(v.Volver) } class={ "no-imprimir " + claseEnlace }>{ v.TextoVolver }</a>
			</div>
		</div>
		for _, s := range v.Secciones {
			<section id={ s.ID } aria-labelledby={ s.ID + "-titulo" } class="mt-8">
				<h2 id={ s.ID + "-titulo" } class="border-b border-slate-300 pb-1 text-lg font-semibold text-slate-900">{ s.Titulo }</h2>
				if s.Error != "" {
					<p role="alert" class="mt-3 text-sm text-red-700">{ s.Error }</p>
				}
				if s.Vacio != "" {
					<p class="mt-3 text-sm text-slate-700">{ s.Vacio }</p>
				}
				for _, g := range s.Grupos {
					<div class="mt-3 text-sm">
						if g.Titulo != "" {
							<h3 class="font-semibold text-slate-900">{ g.Titulo }</h3>
						}
						if len(g.Lineas) > 0 {
							<ul class="mt-1 space-y-1 text-slate-800">
								for _, l := range g.Lineas {
									<li>{ l }</li>
								}
							</ul>
						}
						if len(g.Filas) > 0 {
							<table class="mt-2 w-full border-collapse text-left">
								<thead>
									<tr class="border-b border-slate-300">
										for _, e := range g.Encabezados {
											<th scope="col" class="py-1 pr-3 font-semibold">{ e }</th>
										}
									</tr>
								</thead>
								<tbody>
									for _, fila := range g.Filas {
										<tr class="border-b border-slate-200 align-top">
											for _, celda := range fila {
												<td class="py-1 pr-3">{ celda }</td>
											}
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
				}
			</section>
		}
	</div>
	<script src="/static/js/imprimir.js" defer></script>
}
