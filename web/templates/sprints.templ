package plantillas

import "strconv"

// ListaDeSprints es la pantalla /proyectos/{id}/sprints: la tabla de sprints y el formulario
// para crear uno.
templ ListaDeSprints(v VistaSprints) {
	<h1 class={ claseTitulo }>Sprints</h1>
	if len(v.Sprints) == 0 {
		<p class="mt-4 text-slate-700">Todavía no hay sprints. Creá el primero más abajo.</p>
	} else {
		<table class="mt-4 w-full border-collapse text-left text-sm">
			<caption class="sr-only">Sprints del proyecto, del más reciente al más antiguo</caption>
			<thead>
				<tr class="border-b border-slate-300">
					<th scope="col" class="py-2 pr-3 font-semibold">Sprint</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Sprint Goal</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Inicio</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Fin</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Estado</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Historias</th>
					<th scope="col" class="py-2 pr-3 font-semibold">SP planificados</th>
					<th scope="col" class="py-2 font-semibold">SP completados</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range v.Sprints {
					<tr class="border-b border-slate-200 align-top">
						<td class="py-2 pr-3"><a href={ templ.URL(s.Detalle) } class={ claseEnlace }>{ s.Nombre }</a></td>
						<td class="py-2 pr-3">{ s.Goal }</td>
						<td class="py-2 pr-3">{ s.Inicio }</td>
						<td class="py-2 pr-3">{ s.Fin }</td>
						<td class="py-2 pr-3">{ s.Estado }</td>
						<td class="py-2 pr-3">{ strconv.Itoa(s.Historias) }</td>
						<td class="py-2 pr-3">{ strconv.Itoa(s.Planificados) }</td>
						<td class="py-2">{ strconv.Itoa(s.Completados) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
	<h2 class="mt-10 text-lg font-semibold text-slate-900">Nuevo sprint</h2>
	<form hx-post={ v.Alta.Accion } class="mt-4 max-w-xl space-y-4">
		<div>
			<label for="sprint_goal" class={ claseEtiqueta }>Sprint Goal</label>
			<textarea id="sprint_goal" name="sprint_goal" rows="2" class={ claseCampo }>{ v.Alta.SprintGoal }</textarea>
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			<div>
				<label for="fecha_inicio" class={ claseEtiqueta }>Fecha de inicio</label>
				<input type="date" id="fecha_inicio" name="fecha_inicio" value={ v.Alta.FechaInicio } class={ claseCampo }/>
			</div>
			<div>
				<label for="fecha_fin" class={ claseEtiqueta }>Fecha de fin</label>
				<input type="date" id="fecha_fin" name="fecha_fin" value={ v.Alta.FechaFin } class={ claseCampo }/>
			</div>
		</div>
		<div>
			<button type="submit" class={ claseBoton }>Crear sprint</button>
		</div>
	</form>
}

// DetalleDeSprint es la pantalla /proyectos/{id}/sprints/{sprint}: el Sprint Goal, los Story
// Points, las historias con marcar o desmarcar, y la asignacion de historias del backlog.
templ DetalleDeSprint(v VistaSprint) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class={ claseTitulo }>{ v.Nombre }</h1>
		<a href={ templ.URL(v.Volver) } class={ claseEnlace }>Ver todos los sprints</a>
	</div>
	<dl class="mt-4 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
		<dt class="font-semibold text-slate-700">Sprint Goal</dt>
		<dd>{ v.Goal }</dd>
		<dt class="font-semibold text-slate-700">Fechas</dt>
		<dd>{ v.Inicio } al { v.Fin }</dd>
		<dt class="font-semibold text-slate-700">Estado</dt>
		<dd>{ v.Estado }</dd>
		<dt class="font-semibold text-slate-700">Story Points</dt>
		<dd>Planificados: { strconv.Itoa(v.Planificados) } · Completados: { strconv.Itoa(v.Completados) }</dd>
	</dl>
	<h2 class="mt-8 text-lg font-semibold text-slate-900">Historias del sprint</h2>
	if len(v.Historias) == 0 {
		<p class="mt-2 text-slate-700">El sprint todavía no tiene historias.</p>
	} else {
		<table class="mt-2 w-full border-collapse text-left text-sm">
			<caption class="sr-only">Historias asignadas al sprint, ordenadas por prioridad</caption>
			<thead>
				<tr class="border-b border-slate-300">
					<th scope="col" class="py-2 pr-3 font-semibold">#</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Título</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Prioridad</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Story Points</th>
					<th scope="col" class="py-2 pr-3 font-semibold">Estado</th>
					if v.Abierto {
						<th scope="col" class="py-2 font-semibold">Acciones</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, h := range v.Historias {
					<tr class="border-b border-slate-200 align-top">
						<td class="py-2 pr-3">{ strconv.Itoa(h.Numero) }</td>
						<td class="py-2 pr-3">{ h.Titulo }</td>
						<td class="py-2 pr-3">{ h.Prioridad }</td>
						<td class="py-2 pr-3">{ h.Puntos }</td>
						<td class="py-2 pr-3">{ h.Estado }</td>
						if v.Abierto {
							<td class="py-2">
								<form hx-post={ h.Accion }>
									<button type="submit" aria-label={ h.TextoAccion + ": " + h.Titulo } class={ claseBotonChico }>{ h.TextoAccion }</button>
								</form>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	}
	if v.Abierto {
		<h2 class="mt-8 text-lg font-semibold text-slate-900">Asignar una historia</h2>
		if len(v.Disponibles) == 0 {
			<p class="mt-2 text-slate-700">No hay historias para asignar.</p>
		} else {
			<form hx-post={ v.AccionAsignar } class="mt-2 flex max-w-xl flex-wrap items-end gap-4">
				<div class="min-w-0 flex-1">
					<label for="item" class={ claseEtiqueta }>Historia del backlog</label>
					<select id="item" name="item" class={ claseCampo }>
						for _, o := range v.Disponibles {
							<option value={ o.Valor }>{ o.Texto }</option>
						}
					</select>
				</div>
				<button type="submit" class={ claseBoton }>Asignar</button>
			</form>
		}
	}
}
